# Normalize line endings so clones on any OS match the repository.
* text=auto eol=lf

# Windows scripts keep native endings if any are added later.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pkl binary
